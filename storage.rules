rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event cover images. Readable by anyone with the URL (they're embedded
    // in invitation emails). Writable only by the event's owner.
    match /covers/{eventId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/events/$(eventId)).data.ownerUid == request.auth.uid &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
