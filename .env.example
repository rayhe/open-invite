# Copy to functions/.env and fill in. Never commit the real file.
RESEND_API_KEY=re_your_send_key_here
RESEND_FROM="Invitations <invites@yourdomain.com>"
APP_BASE_URL="https://yourproject.web.app"
# From Resend → Webhooks → your endpoint → Signing Secret. Powers delivery/open analytics.
RESEND_WEBHOOK_SECRET=whsec_...
